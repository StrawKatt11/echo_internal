; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Echo Runner"
config/version="0.8.2"
run/main_scene="uid://bo7kx0r6ufee1"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="uid://b2pkvrqthvc3q"
config/windows_native_icon="res://rUmZdlC.ico"

[autoload]

Skins="*res://World/Scripts/skins.gd"
Transition="*res://World/Scenes/HUD/transition.tscn"
GlobalTime="*res://World/Scripts/Time.gd"
Stopwatch="*res://World/Scripts/stopwatch.gd"

[display]

window/size/viewport_width=1056
window/size/viewport_height=548
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"
mouse_cursor/custom_image="uid://j44ylw8wvv7c"

[dotnet]

project/assembly_name="Prototype"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[file_customization]

folder_colors={
"res://Assets/": "red",
"res://Entity/": "yellow",
"res://Test folder/": "purple",
"res://World/": "green"
}

[global_group]

player="Player character group"

